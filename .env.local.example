# Copie este arquivo para .env.local e preencha com a sua chave.
#   cp .env.local.example .env.local
#
# A chave precisa das seguintes APIs habilitadas no Google Cloud Console:
#   - Maps JavaScript API   (mapa)
#   - Geocoding API         (busca de endereco)
#   - Elevation API         (altitude dos pontos)
#
# Como a chave e exposta no browser (NEXT_PUBLIC_), restrinja-a por
# referenciador HTTP (o dominio da loja) no Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opcional: Map ID (necessario para os marcadores avancados com estilo proprio).
# Se ficar vazio, o app usa o DEMO_MAP_ID do Google, que ja funciona para testes.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
